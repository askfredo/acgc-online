static const f32 kani_wait_range_tbl[3] = { 300.f, 200.f, 100.f };
static const f32 kani_wait_base_tbl[3] = { 100.f, 100.f, 100.f };

static const f32 kani_move_range_tbl[3] = { 560.f, 400.f, 300.f };
static const f32 kani_move_base_tbl[3] = { 40.f, 40.f, 40.f };

static int kani_idx_tbl[5] = { 0x2c, 0x2d, 0x2e, 0x2f, 0x30 };

