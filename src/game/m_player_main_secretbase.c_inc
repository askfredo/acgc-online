/* Deluxe edition: Secretbase (pitfall trap variant) player actions */

/* ===== Request functions ===== */

static int Player_actor_request_main_ready_secretbase_all(GAME* game, const xyz_t* pos_p, int prio) {
    if (Player_actor_check_request_main_able(game, mPlayer_INDEX_READY_SECRETBASE, prio)) {
        PLAYER_ACTOR* player = GET_PLAYER_ACTOR_GAME(game);
        mPlayer_request_ready_pitfall_c* req_ready_p = &player->requested_main_index_data.ready_pitfall;

        req_ready_p->pos = *pos_p;
        Player_actor_request_main_index(game, mPlayer_INDEX_READY_SECRETBASE, prio);
        return TRUE;
    }

    return FALSE;
}

static int Player_actor_request_main_fall_secretbase_all(GAME* game, f32 val, int ival, int prio) {
    if (Player_actor_check_request_main_able(game, mPlayer_INDEX_FALL_SECRETBASE, prio)) {
        PLAYER_ACTOR* player = GET_PLAYER_ACTOR_GAME(game);

        player->requested_main_index_data.fall_secretbase.val = val;
        player->requested_main_index_data.fall_secretbase.ival = ival;
        Player_actor_request_main_index(game, mPlayer_INDEX_FALL_SECRETBASE, prio);
        return TRUE;
    }

    return FALSE;
}

static int Player_actor_request_main_struggle_secretbase_all(GAME* game, f32 val, int ival, int prio) {
    if (Player_actor_check_request_main_able(game, mPlayer_INDEX_STRUGGLE_SECRETBASE, prio)) {
        PLAYER_ACTOR* player = GET_PLAYER_ACTOR_GAME(game);

        player->requested_main_index_data.fall_secretbase.val = val;
        player->requested_main_index_data.fall_secretbase.ival = ival;
        Player_actor_request_main_index(game, mPlayer_INDEX_STRUGGLE_SECRETBASE, prio);
        return TRUE;
    }

    return FALSE;
}

/* ===== Setup functions ===== */

static void Player_actor_setup_main_Ready_secretbase(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    cKF_SkeletonInfo_R_c* kf0_p = &player->keyframe0;
    mPlayer_request_ready_pitfall_c* req_ready_p = &player->requested_main_index_data.ready_pitfall;
    int anim1_idx;
    int part_table_idx;

    player->main_data.secretbase.val = 0.0f;
    player->main_data.secretbase.ival = 0;
    Player_actor_SetupItem_Base1(actorx, mPlayer_ANIM_GURATUKU1, -5.0f, &anim1_idx, &part_table_idx);
    cKF_SkeletonInfo_R_Animation_Set_base_shape_trs(kf0_p, 0.0f, 1000.0f, 0.0f, 0, 0, DEG2SHORT_ANGLE2(90.0f));
    cKF_SkeletonInfo_R_AnimationMove_ct_base(&actorx->world.position, &req_ready_p->pos,
                                             actorx->shape_info.rotation.y, actorx->shape_info.rotation.y, 5.0f, kf0_p,
                                             cKF_ANIMATION_TRANS_XZ | cKF_ANIMATION_TRANS_Y);
    Player_actor_InitAnimation_Base2(actorx, game, mPlayer_ANIM_GURATUKU1, anim1_idx, 1.0f, 1.0f, 0.5f, -5.0f,
                                     cKF_FRAMECONTROL_STOP, part_table_idx);
    Player_actor_setup_main_Base(actorx, game);
}

static void Player_actor_setup_main_Fall_secretbase(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    cKF_SkeletonInfo_R_c* kf0_p = &player->keyframe0;
    int item_kind = Player_actor_Get_ItemKind(actorx, player->requested_main_index);
    int anim0_idx = Player_actor_Get_PlayerAnimeIndex_fromItemKind_Fall_pitfall(item_kind);
    int anim1_idx;
    int part_table_idx;

    player->main_data.secretbase.val = player->requested_main_index_data.fall_secretbase.val;
    player->main_data.secretbase.ival = player->requested_main_index_data.fall_secretbase.ival;
    Player_actor_SetupItem_Base1(actorx, anim0_idx, -5.0f, &anim1_idx, &part_table_idx);
    cKF_SkeletonInfo_R_Animation_Set_base_shape_trs(kf0_p, 0.0f, 1000.0f, 0.0f, 0, 0, DEG2SHORT_ANGLE2(90.0f));
    cKF_SkeletonInfo_R_AnimationMove_ct_base(&actorx->world.position, &actorx->world.position,
                                             actorx->shape_info.rotation.y, actorx->shape_info.rotation.y, 5.0f, kf0_p,
                                             cKF_ANIMATION_TRANS_XZ | cKF_ANIMATION_TRANS_Y);
    Player_actor_InitAnimation_Base2(actorx, game, anim0_idx, anim1_idx, 1.0f, 1.0f, 0.5f, -5.0f,
                                     cKF_FRAMECONTROL_STOP, mPlayer_PART_TABLE_NORMAL);
    Player_actor_setup_main_Base(actorx, game);
}

static void Player_actor_setup_main_Struggle_secretbase(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    int anim1_idx;
    int part_table_idx;

    player->main_data.secretbase.val = player->requested_main_index_data.fall_secretbase.val;
    player->main_data.secretbase.ival = player->requested_main_index_data.fall_secretbase.ival;
    Player_actor_SetupItem_Base1(actorx, mPlayer_ANIM_MOGAKU1, -5.0f, &anim1_idx, &part_table_idx);
    Player_actor_InitAnimation_Base1(actorx, game, mPlayer_ANIM_MOGAKU1, anim1_idx, 1.0f, 1.0f, 0.5f, -5.0f,
                                     mPlayer_PART_TABLE_NORMAL);
    player->draw_effect_idx = eEC_EFFECT_ASE2 + 1;
    Player_actor_setup_main_Base(actorx, game);
}

/* ===== Settle functions ===== */

static void Player_actor_settle_main_Fall_secretbase(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;

    cKF_SkeletonInfo_R_AnimationMove_dt(&player->keyframe0);
}

static void Player_actor_settle_main_Ready_secretbase(ACTOR* actorx, GAME* game) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    cKF_SkeletonInfo_R_c* kf0_p = &player->keyframe0;

    cKF_SkeletonInfo_R_AnimationMove_dt(kf0_p);
    eEC_CLIP->effect_kill_proc(eEC_EFFECT_ASE2, RSV_NO);
}

static void Player_actor_settle_main_Struggle_secretbase(ACTOR* actorx, GAME* game) {
    eEC_CLIP->effect_kill_proc(eEC_EFFECT_ASE2, RSV_NO);
}

/* ===== CulcAnimation ===== */

static int Player_actor_CulcAnimation_Fall_secretbase(ACTOR* actorx, f32* last_anim0_cur_frame_p) {
    return Player_actor_CulcAnimation_Base2(actorx, last_anim0_cur_frame_p);
}

static int Player_actor_CulcAnimation_Ready_secretbase(ACTOR* actorx, f32* last_anim0_cur_frame_p) {
    return Player_actor_CulcAnimation_Base2(actorx, last_anim0_cur_frame_p);
}

static int Player_actor_CulcAnimation_Struggle_secretbase(ACTOR* actorx) {
    f32 unused;
    return Player_actor_CulcAnimation_Base2(actorx, &unused);
}

/* ===== ObjCheck ===== */

static void Player_actor_ObjCheck_Fall_secretbase(ACTOR* actorx, GAME* game) {
    Player_actor_Excute_Corect_forStand(actorx, game);
}

static void Player_actor_ObjCheck_Ready_secretbase(ACTOR* actorx, GAME* game) {
    Player_actor_Excute_Corect_forStand(actorx, game);
}

static void Player_actor_ObjCheck_Struggle_secretbase(ACTOR* actorx, GAME* game) {
    Player_actor_Excute_Corect_forStand(actorx, game);
}

/* ===== Movement ===== */

static void Player_actor_Movement_Fall_secretbase(ACTOR* actorx) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    cKF_SkeletonInfo_R_c* kf0_p = &player->keyframe0;

    cKF_SkeletonInfo_R_AnimationMove_base(&actorx->world.position, &actorx->shape_info.rotation.y, &actorx->scale,
                                          actorx->world.angle.y, kf0_p);
    Player_actor_Movement_Base_Stop(actorx, FALSE);
}

static void Player_actor_Movement_Ready_secretbase(ACTOR* actorx) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    cKF_SkeletonInfo_R_c* kf0_p = &player->keyframe0;

    cKF_SkeletonInfo_R_AnimationMove_base(&actorx->world.position, &actorx->shape_info.rotation.y, &actorx->scale,
                                          actorx->world.angle.y, kf0_p);
    Player_actor_Movement_Base_Stop(actorx, FALSE);
}

static void Player_actor_Movement_Struggle_secretbase(ACTOR* actorx) {
    Player_actor_Movement_Base_Stop(actorx, FALSE);
}

/* ===== BGcheck ===== */

static void Player_actor_BGcheck_Fall_secretbase(ACTOR* actorx) {
    Player_actor_BGcheck_common_type1(actorx);
}

/* ===== Eye pattern ===== */

static void Player_actor_set_eye_pattern_Ready_secretbase(ACTOR* actorx) {
    Player_actor_set_eye_pattern_normal(actorx);
}

static void Player_actor_set_eye_pattern_Fall_secretbase(ACTOR* actorx) {
    Player_actor_set_eye_pattern_normal(actorx);
}

static void Player_actor_set_eye_pattern_Struggle_secretbase(ACTOR* actorx) {
    Player_actor_set_tex_anime_pattern(actorx);
    Player_actor_set_eye_pattern(actorx, 6);
}

/* ===== SetEffect / SearchAnimation ===== */

static void Player_actor_SetEffect_Ready_secretbase(ACTOR* actorx) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    cKF_SkeletonInfo_R_c* kf0_p = &player->keyframe0;
    cKF_FrameControl_c* fc0_p = &kf0_p->frame_control;

    if (Player_actor_Check_AnimationFrame(fc0_p, 5.0f)) {
        player->draw_effect_idx = eEC_EFFECT_ASE2 + 1;
    }
}

static void Player_actor_SearchAnimation_Ready_secretbase(ACTOR* actorx, f32 frame) {
    if (Player_actor_Check_AnimationFrame_PerfectEquel(actorx, frame) == FALSE) {
        Player_actor_SetEffect_Ready_secretbase(actorx);
        Player_actor_SetSound_Ready_secretbase(actorx);
    }
}

/* ===== request_proc_index ===== */

static void Player_actor_request_proc_index_fromReady_secretbase(GAME* game, int end_flag) {
    if (end_flag) {
        PLAYER_ACTOR* player = GET_PLAYER_ACTOR_GAME(game);

        Player_actor_request_main_fall_secretbase_all(game, player->main_data.secretbase.val,
                                                      player->main_data.secretbase.ival,
                                                      mPlayer_REQUEST_PRIORITY_28);
    }
}

static void Player_actor_request_proc_index_fromFall_secretbase(GAME* game, int end_flag) {
    if (end_flag) {
        PLAYER_ACTOR* player = GET_PLAYER_ACTOR_GAME(game);

        Player_actor_request_main_struggle_secretbase_all(game, player->main_data.secretbase.val,
                                                          player->main_data.secretbase.ival,
                                                          mPlayer_REQUEST_PRIORITY_28);
    }
}

/* ===== CheckAndRequest_NextGoToSecretbase ===== */

static void Player_actor_CheckAndRequest_NextGotoSecretbase_common(ACTOR* actorx, f32* timer_p, int* state_p) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;
    f32 timer;

    timer = *timer_p;
    timer += 1.0f;
    *timer_p = timer;

    if (timer >= 60.0f) {
        if (!mDemo_Check(mDemo_TYPE_EXITSCENE, actorx)) {
            mDemo_Request(mDemo_TYPE_EXITSCENE, actorx, Player_actor_set_nextgoto_info_type3);
        }
    }
}

static void Player_actor_CheckAndRequest_NextGoToSecretbase_Ready_secretbase(ACTOR* actorx) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;

    Player_actor_CheckAndRequest_NextGotoSecretbase_common(actorx, &player->main_data.secretbase.val,
                                                            &player->main_data.secretbase.ival);
}

static void Player_actor_CheckAndRequest_NextGoToSecretbase_Fall_secretbase(ACTOR* actorx) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;

    Player_actor_CheckAndRequest_NextGotoSecretbase_common(actorx, &player->main_data.secretbase.val,
                                                            &player->main_data.secretbase.ival);
}

static void Player_actor_CheckAndRequest_NextGoToSecretbase_Struggle_secretbase(ACTOR* actorx) {
    PLAYER_ACTOR* player = (PLAYER_ACTOR*)actorx;

    Player_actor_CheckAndRequest_NextGotoSecretbase_common(actorx, &player->main_data.secretbase.val,
                                                            &player->main_data.secretbase.ival);
}

/* ===== Main per-frame functions ===== */

static void Player_actor_main_Ready_secretbase(ACTOR* actorx, GAME* game) {
    f32 last_anim0_cur_frame;
    int end_flag;

    end_flag = Player_actor_CulcAnimation_Ready_secretbase(actorx, &last_anim0_cur_frame);
    Player_actor_Movement_Ready_secretbase(actorx);
    Player_actor_Reinput_force_position_angle(actorx, game);
    Player_actor_SearchAnimation_Ready_secretbase(actorx, last_anim0_cur_frame);
    Player_actor_recover_lean_angle(actorx);
    Player_actor_set_eye_pattern_Ready_secretbase(actorx);
    Player_actor_ObjCheck_Ready_secretbase(actorx, game);
    Player_actor_Item_main(actorx, game);
    Player_actor_request_proc_index_fromReady_secretbase(game, end_flag);
}

static void Player_actor_main_Fall_secretbase(ACTOR* actorx, GAME* game) {
    f32 last_anim0_cur_frame;
    int end_flag;

    end_flag = Player_actor_CulcAnimation_Fall_secretbase(actorx, &last_anim0_cur_frame);
    Player_actor_Movement_Fall_secretbase(actorx);
    Player_actor_Reinput_force_position_angle(actorx, game);
    Player_actor_recover_lean_angle(actorx);
    Player_actor_set_eye_pattern_Fall_secretbase(actorx);
    Player_actor_ObjCheck_Fall_secretbase(actorx, game);
    Player_actor_Item_main(actorx, game);
    Player_actor_request_proc_index_fromFall_secretbase(game, end_flag);
}

static void Player_actor_main_Struggle_secretbase(ACTOR* actorx, GAME* game) {
    Player_actor_Movement_Struggle_secretbase(actorx);
    Player_actor_Reinput_force_position_angle(actorx, game);
    Player_actor_CulcAnimation_Struggle_secretbase(actorx);
    Player_actor_recover_lean_angle(actorx);
    Player_actor_set_eye_pattern_Struggle_secretbase(actorx);
    Player_actor_ObjCheck_Struggle_secretbase(actorx, game);
    Player_actor_Item_main(actorx, game);
}
