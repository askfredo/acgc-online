#include "ac_museum_fish_priv.h"

/* Hirame (flatfish) - bottom-dwelling, swims in bursts with rest periods */

void mfish_hirame_wait_process(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game);
void mfish_hirame_move_process_init(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game);
void mfish_hirame_move_process(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game);

void mfish_hirame_wait_process_init(MUSEUM_FISH_PRIVATE_DATA* actor) {
    actor->currentProcess = mfish_hirame_wait_process;
    actor->activityFrameCount =
        actor->init_data.activeFramesMin + (s16)RANDOM_F(actor->init_data.activeFramesRange);
}

void mfish_hirame_wait_process(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game) {
    f32 drag = 1.0f - actor->init_data._18;
    f32 decel = 0.05f;

    add_calc2(&actor->_5E8, 0.0f, drag, decel);
    add_calc_short_angle2(&actor->_60C.y, actor->_612.y,
                          CALC_EASE2(0.1f), DEG2SHORT_ANGLE(1.25f), DEG2SHORT_ANGLE(0.25f));

    if (actor->activityFrameCount-- <= 0) {
        mfish_hirame_move_process_init(actor, game);
    }
}

void mfish_hirame_move_process_init(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game) {
    actor->currentProcess = mfish_hirame_move_process;
    actor->_5E8 = actor->init_data._10 + RANDOM_F(actor->init_data._14);
}

void mfish_hirame_move_process(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game) {
    f32 drag = 1.0f - actor->init_data._18;
    f32 decel = 0.05f;
    f32 speed_ratio;
    s16 turn_speed;

    /* Decelerate */
    add_calc2(&actor->_5E8, 0.0f, drag, decel);

    /* Turn towards target */
    speed_ratio = MAX(actor->_5E8 / (actor->init_data._14 + actor->init_data._10), 0.4f);
    turn_speed = (s16)(speed_ratio * DEG2SHORT_ANGLE(30));
    turn_speed = MY_MAX(turn_speed, DEG2SHORT_ANGLE(10));

    actor->_622 = add_calc_short_angle2(&actor->_60C.y, actor->_612.y,
                                        CALC_EASE2(0.3f), (s16)(turn_speed >> 1) >> 1,
                                        DEG2SHORT_ANGLE(0.25f));
    add_calc_short_angle2(&actor->_618.z, actor->_622, CALC_EASE2(0.25f),
                          DEG2SHORT_ANGLE(2.5f), DEG2SHORT_ANGLE(0.25f));

    /* Wall avoidance */
    if (actor->_62E_flags & 0x1e) {
        if ((s16)(actor->_60C.y - actor->_62C) > 0) {
            actor->_612.y = actor->_62C + DEG2SHORT_ANGLE(115);
        } else {
            actor->_612.y = actor->_62C - DEG2SHORT_ANGLE(115);
        }
        actor->_5E8 = actor->init_data._14 + actor->init_data._10;
    } else if (actor->_62E_flags & 0x20) {
        s16 esc = mfish_get_escape_angle(actor, game);
        add_calc_short_angle2(&actor->_612.y, esc, CALC_EASE(0.5f),
                              DEG2SHORT_ANGLE(15), DEG2SHORT_ANGLE(0.5f));
    }

    /* Compute velocity */
    actor->_5D0.x = actor->_5E8 * sin_s(actor->_60C.y);
    actor->_5D0.z = actor->_5E8 * cos_s(actor->_60C.y);

    /* Move and check for slowdown */
    if (actor->_5E8 < 0.05f) {
        mfish_hirame_wait_process_init(actor);
    }
}

void mfish_hirame_ct(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game) {
    s16 s;

    s = qrand();
    mfish_onefish_ct(actor, game);
    mfish_base_ct(actor, game);
    mfish_hirame_wait_process_init(actor);
    actor->position.y = 55.0f;
    actor->hari_scale_x = 0.0f;
    actor->hari_scale_y = 0.0f;
    actor->_60C.y = s;
    actor->_612.y = s;
}

void mfish_hirame_mv(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game) {
    xyz_t p;
    f32 anim_speed;
    f32 reg_a;
    f32 reg_b;

    mfish_onefish_mv(actor, game);

    /* Animation speed from debug regs and speed */
    reg_a = GETREG(TAKREG, 0x69) * 0.01f + 0.5f;
    reg_b = GETREG(TAKREG, 0x6A) * 0.01f + 1.2f;
    anim_speed = actor->_5E8 * reg_b + reg_a;
    actor->kf.keyframe.frame_control.speed = anim_speed;

    /* Call current process */
    actor->currentProcess(actor, game);

    /* Apply movement */
    mfish_get_flow_vec(&p, actor, game);
    actor->position.x += actor->_5D0.x + p.x;
    actor->position.z += actor->_5D0.z + p.z;

    /* Body wave */
    mfish_body_wind_anime_play(actor, game);
    Museum_Fish_BGCheck(actor, game);

    /* Clamp to bottom */
    add_calc2(&actor->position.y, 55.0f, 0.1f, 0.1f);
}

BOOL mfish_hirame_before_disp(GAME* game, cKF_SkeletonInfo_R_c* keyframe, int joint_idx,
                              Gfx** joint_shape, u8* joint_flags, void* arg,
                              s_xyz* joint_rot, xyz_t* joint_pos) {
    MUSEUM_FISH_PRIVATE_DATA* actor = (MUSEUM_FISH_PRIVATE_DATA*)arg;
    s16 reg_val;
    s16 speed_angle;

    /* Spine wiggle from debug register and speed */
    reg_val = GETREG(TAKREG, 0x6D);
    speed_angle = (s16)(0.5f * reg_val);
    actor->_63A += speed_angle;

    if (joint_idx == 2) {
        /* Apply tail fin undulation based on sin of accumulated angle and speed */
        f32 sin_val = sin_s(actor->_63A);
        f32 scale_factor = actor->_5E8 * sin_val;
        s16 rot = (s16)(scale_factor * DEG2SHORT_ANGLE(15));

        joint_rot->y = (s16)(joint_rot->y + rot);
        joint_rot->y = MY_CLAMP((int)joint_rot->y, DEG2SHORT_ANGLE(-80), DEG2SHORT_ANGLE(80));
    }

    return TRUE;
}

void mfish_hirame_dw(MUSEUM_FISH_PRIVATE_DATA* actor, GAME* game) {
    mfish_keyframe_c* skele;
    Mtx* mtxp;

    skele = &actor->kf;
    if (game->frame_counter & 1) {
        mtxp = skele->mtx[0];
    } else {
        mtxp = skele->mtx[1];
    }

    OPEN_DISP(game->graph);
    Matrix_translate(actor->position.x, actor->position.y, actor->position.z, MTX_LOAD);
    Matrix_rotateXYZ(actor->_60C.x, actor->_60C.y, actor->_60C.z, MTX_MULT);
    Matrix_translate(0.0f, 0.0f, actor->init_data.ofs_z, MTX_MULT);
    Matrix_scale(actor->init_data.renderScale, actor->init_data.renderScale,
                 actor->init_data.renderScale, MTX_MULT);
    gSPMatrix(NEXT_POLY_OPA_DISP, _Matrix_to_Mtx_new(game->graph),
              G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    cKF_Si3_draw_R_SV(game, &skele->keyframe, mtxp, mfish_hirame_before_disp, NULL, actor);
    CLOSE_DISP(game->graph);
}
